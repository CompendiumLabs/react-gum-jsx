{
  "name": "gum-jsx-react",
  "version": "0.1.0",
  "description": "A React adapter for gum-jsx",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/react-gum-jsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/react-gum-jsx"
  },
  "license": "MIT",
  "files": [
    "src",
    "scripts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun ./scripts/test.tsx",
    "typecheck": "bun tsc --noEmit",
    "gum-react": "bun ./scripts/gum-react.tsx"
  },
  "bin": {
    "gum-react": "./scripts/gum-react.tsx"
  },
  "dependencies": {
    "@gum-jsx/core": "link:@gum-jsx/core",
    "@gum-jsx/math": "link:@gum-jsx/math",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-reconciler": "^0.33.0",
    "commander": "^14.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-reconciler": "^0.33.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
