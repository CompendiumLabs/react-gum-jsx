{
  "name": "@gum-jsx/react",
  "version": "1.8.0",
  "description": "A React adapter for gum-jsx",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/react-gum-jsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/react-gum-jsx.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "scripts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun ./scripts/test.tsx",
    "typecheck": "bun tsc --noEmit",
    "gum-react": "bun ./scripts/gum-react.tsx"
  },
  "bin": {
    "gum-react": "scripts/gum-react.tsx"
  },
  "peerDependencies": {
    "@gum-jsx/core": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@gum-jsx/math": "^1.8.0",
    "@types/react-reconciler": "^0.33.0",
    "commander": "^14.0.3",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@gum-jsx/core": "^1.8.0",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
